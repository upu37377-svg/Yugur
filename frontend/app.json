{
  "expo": {
    "name": "Yugur",
    "slug": "yugur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yugur",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to track your running routes and territories.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to track your running routes and territories.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to set your avatar.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos for your avatar.",
        "NSMotionUsageDescription": "This app needs access to motion data for activity tracking."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBidVabQ95l3IK1Jrwv7Lmz7tqH8v2YT5s"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1E3A5F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBidVabQ95l3IK1Jrwv7Lmz7tqH8v2YT5s"
        }
      },
      "package": "com.muhammadjon_007.yugur"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E3A5F"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Yugur to use your location to track running routes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yugur to access your photos to set your avatar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a9fe7a2-5dbf-41d0-ac61-7bafa9f49c54"
      }
    }
  }
}
